    <!-- FR-8: inventory tab (docs/design/10-inventory.md) -->
    <string name="inventory_section_wallet">Wallet</string>
    <string name="inventory_section_equipped">Equipped</string>
    <!-- Only ever read for a container property whose name field is blank. -->
    <string name="inventory_section_container">Container</string>
    <!-- FR-10 (11 decision 3): what was one "Carried" section is now these three. -->
    <string name="inventory_section_weapons">Weapons</string>
    <string name="inventory_section_armor">Armor</string>
    <string name="inventory_section_gear">Gear</string>
    <!-- FR-11 (11 decision 4): the collapsed wallet. The summary itself is built in
         WalletUiState, because it is numbers; this is the all-zero case, which is a word. -->
    <string name="inventory_wallet_empty">Empty</string>
    <string name="inventory_wallet_expand">Show the coin steppers</string>
    <string name="inventory_wallet_collapse">Hide the coin steppers</string>
    <!-- FR-16 (13 decisions 1 and 5): every other section header is an expander too. The
         wallet keeps its own two action strings above — its chevron opens *steppers*, which
         is a different promise from "show me this list", and 13 decision 3 makes the wallet
         the one section whose state is not remembered anyway.

         The state word and the action are two separate strings on purpose (13 decision 5's
         sentence): the first states a FACT about the section, the second offers an ACTION —
         the same verb-versus-state split the equip chip draws above. Lower case and
         verb-first because both are the tail of a spoken sentence, not labels:
         "Armor, 3 items, 41 lb, collapsed, tap to expand". -->
    <string name="inventory_section_collapsed">collapsed</string>
    <string name="inventory_section_expanded">expanded</string>
    <string name="inventory_section_expand">tap to expand</string>
    <string name="inventory_section_collapse">tap to collapse</string>
    <!-- A plural and not "%1$d items", because this one is read aloud by TalkBack on every
         section header and "1 items" is heard in full. -->
    <plurals name="inventory_section_items">
        <item quantity="one">%1$d item</item>
        <item quantity="other">%1$d items</item>
    </plurals>
    <!-- FR-10b (13 decision 9): the Weapon / Armor / Gear chooser, on the custom item form and
         on the local editor's item rows. Singular, and separate strings from the section
         headings above even though two of them read the same today: a heading names a list,
         these name what one item IS. See `CategoryChooser`. -->
    <string name="inventory_category_label">What is it?</string>
    <string name="inventory_category_weapon">Weapon</string>
    <string name="inventory_category_armor">Armor</string>
    <string name="inventory_category_gear">Gear</string>
    <!-- 11 decision 2: the per-item equippability override, shown only where this app could
         not tell from the sheet's own tags. -->
    <string name="inventory_detail_equippable">Can be equipped</string>
    <string name="inventory_detail_equippable_hint">This sheet doesn\'t say what %1$s is. Turn this on to get an equip control for it.</string>
    <!-- The top line. Two forms because capacity is nullable: a sheet that expresses no
         Strength gets no denominator rather than an invented one (10 decision 8). -->
    <string name="inventory_carried">%1$s lb carried</string>
    <string name="inventory_carried_of">%1$s / %2$s lb</string>
    <string name="inventory_over_capacity">Over capacity</string>
    <!-- 10 decision 9. Rendered only when the sheet says anything at all about attunement. -->
    <string name="inventory_attuned">Attuned %1$d/%2$d</string>
    <string name="inventory_weight">%1$s lb</string>
    <string name="inventory_value">%1$s gp</string>
    <string name="inventory_quantity">×%1$d</string>
    <!-- An em dash: the source gave no number, which is not the same as zero. -->
    <string name="inventory_unknown">—</string>
    <string name="inventory_wallet_total">%1$s gp total</string>
    <string name="inventory_coin_add">Add one %1$s</string>
    <string name="inventory_coin_remove">Remove one %1$s</string>
    <!-- FR-13 (12 decision 2): the equip chip's two words. The unequipped chip offers an
         ACTION, the equipped one states a FACT — one word each, and the chip's own label rather
         than a tint is what carries the difference. `inventory_chip_equipped` is deliberately a
         separate string from `inventory_section_equipped` above even though both read
         "Equipped" today: one is a section heading and one is a control's label, and a
         translator is entitled to render a heading and a button differently. -->
    <string name="inventory_chip_equip">Equip</string>
    <string name="inventory_chip_equipped">Equipped</string>
    <!-- The spoken half of the same split, joined to the item's name (and, when it is equipped,
         to the word above) by InventoryRowState.spokenEquipLabel. Lower case and verb-first
         because they are the tail of a sentence, not a label: "Longsword, tap to equip". -->
    <string name="inventory_equip_action">tap to equip</string>
    <string name="inventory_unequip_action">tap to unequip</string>
    <string name="inventory_open_detail">%1$s — open details</string>
    <!-- FR-9 (12 decision 7): delete, behind a destructive confirm. The two warning lines are
         chosen by InventoryRowState.deleteWarningRes and are the whole point of the dialog —
         a DiceCloud delete is a soft-remove and genuinely reversible, a local one deletes the
         row. Saying which BEFORE the tap beats leaving the player to notice a missing UNDO. -->
    <string name="inventory_delete">Delete</string>
    <string name="inventory_delete_title">Delete %1$s?</string>
    <string name="inventory_delete_undoable">You can undo this straight afterwards.</string>
    <string name="inventory_delete_permanent">This can\'t be undone.</string>
    <string name="inventory_delete_confirm">Delete</string>
    <!-- FR-9 (12 decision 8): move. `inventory_move_carried` names the destination the player
         understands — loose in the pack — rather than the `carried`-tagged folder it resolves
         to, which is a piece of sheet structure this app has never shown them. -->
    <string name="inventory_move">Move to…</string>
    <string name="inventory_move_title">Move %1$s</string>
    <string name="inventory_move_carried">Carried</string>
    <string name="inventory_empty">Nothing carried yet</string>
    <string name="inventory_empty_hint">Coins are always here. Tap + to put something else on this sheet.</string>

    <!-- Item detail sheet (10 decision 7) -->
    <string name="inventory_detail_quantity">Quantity</string>
    <string name="inventory_detail_weight">Weight, each</string>
    <string name="inventory_detail_value">Value, each</string>
    <string name="inventory_detail_stack">%1$s lb · %2$s gp for all %3$d</string>
    <string name="inventory_detail_description">Description</string>
    <string name="inventory_detail_attunement">Attunement</string>
    <string name="inventory_attunement_requires">Requires attunement</string>
    <string name="inventory_attunement_attuned">Attuned</string>
    <string name="inventory_attunement_not_attuned">Not attuned</string>

    <!-- FR-14 (12 decision 3): the inventory customize sheet. It reuses the tracker sheet's
         control vocabulary wholesale — customize_move_up / _down / _hide / _show / _hidden /
         _reset are the same strings on both sheets, deliberately, because they are the same
         controls and a second spelling of "Move %1$s up" is a second thing to translate.
         What is NOT shared is the title and the subtitle, because hiding means something
         different here: on the tracker it removes a row, on this tab it only regroups one. -->
    <string name="inventory_customize_title">Customize inventory</string>
    <string name="inventory_customize_subtitle">Reorder the sections on this tab. Hiding one folds its items into Gear — nothing is ever hidden from you. Saved on this device only.</string>
    <!-- Shown under a folded section in the Hidden list, so "where did my weapons go" is
         answered on the screen that did it rather than by the player scrolling to find out. -->
    <string name="inventory_customize_folded">Its items are in Gear</string>
    <!-- The wallet is the one hide that removes rather than regroups, and it is allowed to
         because coins are not items and appear nowhere else on the tab. Said plainly, because
         it is the one place the sheet's promise above does not apply. -->
    <string name="inventory_customize_wallet_hidden">Your coins are still on the character sheet</string>

