<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Themed-icon layer (Android 13+). A dedicated flat-white drawable, not the
         foreground reused: the foreground's palette would be thrown away by the
         system tint anyway, and a separate file makes the silhouette explicit. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
