<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for themed icons (Android 13+). The system tints this with the
  user's theme colours, so every path here is a single flat #FFFFFF and the shape
  alone has to carry the mark. Same geometry as ic_launcher_foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- d20, face-on. Viewed down a 3-fold axis an icosahedron projects to a
         regular hexagon (the middle ring of 6 vertices) with the 3 front-face
         vertices on the SAME rays as alternating hexagon vertices — hence
         hexagon + upward triangle + three radial spokes. Spokes on the
         triangle's own rays is what makes it read as a die and not a cube. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.75"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M54.0,24.59 L64.58,30.69 L64.58,42.91 L54.0,49.01 L43.42,42.91 L43.42,30.69 Z" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.75"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M54.0,30.78 L48.79,39.81 L59.21,39.81 Z" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.75"
        android:strokeLineCap="round"
        android:pathData="M54.0,30.78 L54.0,24.59 M48.79,39.81 L43.42,42.91 M59.21,39.81 L64.58,42.91" />

    <!-- The floating hand: palm as a filled blob, digits as round-capped
         strokes. The whole mark is scaled to 86% of the 66dp safe zone about the
         centre — filling the safe zone exactly reads as cramped once a launcher's
         circle mask is applied (docs/verification/WP8.md §4). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40.58,69.05 C40.58,66.38 42.65,64.84 45.23,64.84 L62.77,64.84 C65.35,64.84 67.42,66.38 67.42,69.05 C67.42,77.13 61.4,81.86 54.0,81.86 C46.6,81.86 40.58,77.13 40.58,69.05 Z" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.68"
        android:strokeLineCap="round"
        android:pathData="M44.37,67.33 L42.99,58.82 M50.22,66.47 L49.53,56.06 M56.58,66.47 L56.92,55.55 M62.94,67.33 L64.49,57.61" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.68"
        android:strokeLineCap="round"
        android:pathData="M42.48,71.63 L33.88,62.08" />
</vector>
